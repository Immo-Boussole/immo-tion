# ==============================================================================
# Immo-Tion Environment Configuration Template
# ==============================================================================

# Environment mode: development / production
APP_ENV=development

# Application port inside the container
APP_PORT=8085

# Secret key for session cookie encryption (generate with: openssl rand -hex 32)
SECRET_KEY=replace_with_a_secure_random_key

# ── Cloudflare Tunnel Configuration ───────────────────────────────────────────
# Zero Trust tunnel token from Cloudflare Zero Trust Dashboard
TUNNEL_TOKEN=

# Anti-bypass Header Enforcement (optional but recommended)
# Format: comma-separated list of "Header-Name" or "Header-Name:Expected-Value"
# Example: CF-Ray,X-Origin-Verify:your_secret_verification_key
REQUIRED_HEADERS=
REQUIRED_HEADERS_EXEMPT_LOCALHOST=true

# ── SMTP Notifications Configuration (Optional) ──────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@immo-tion.local
SMTP_USE_TLS=true

# ── Webhook Notifications (Optional) ──────────────────────────────────────────
# Comma-separated list of webhook endpoints (Discord, Slack, Home Assistant, etc.)
WEBHOOK_URLS=
